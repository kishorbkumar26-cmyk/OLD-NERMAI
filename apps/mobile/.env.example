# ─── Nermai Academy Mobile — Environment Template ───────────────────────────
# Copy this file to .env and fill in your local values.
# .env is gitignored. This file (.env.example) is committed.
#
# LOCAL DEV (Expo Go on a physical device):
#   Set EXPO_PUBLIC_API_URL to your machine's Wi-Fi IPv4 address.
#   Run `ipconfig` (Windows) or `ifconfig` (Mac/Linux) to find your IP.
#   Both your device and machine must be on the SAME Wi-Fi network.
#
# ANDROID EMULATOR (AVD):
#   Use 10.0.2.2 which maps to the host machine's localhost.
#
# PRODUCTION:
#   These values are overridden by CI/CD environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL (Express, port 3000 in dev)
EXPO_PUBLIC_API_URL=

# Web app URL (Vite dev server, port 3001 in dev) — used by ZoomWebViewPlayer
EXPO_PUBLIC_WEB_APP_URL=
